# Aura Campus V2 — Environment Configuration
# Copy this file to .env.local for local development. Never commit real secrets.

# Supabase Project Configuration (Obtained from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Canonical Application URL (used for sharing links, QR codes, and canonical meta tags)
VITE_APP_URL=http://localhost:5173
